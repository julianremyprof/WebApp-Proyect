{
  "name": "prolearnin6",
  "version": "0.1.0",
  "private": true,
  "description": "ProLearnin6 - English learning platform (Phase 1 MVP) deployable on Cloudflare Workers via OpenNext",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "15.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@supabase/supabase-js": "^2.45.4",
    "@supabase/ssr": "^0.5.1",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.9.0",
    "recharts": "^2.12.7",
    "papaparse": "^5.4.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "wrangler": "^3.99.0",
    "typescript": "^5.6.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/papaparse": "^5.3.14",
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
