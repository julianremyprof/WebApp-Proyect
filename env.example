# Copy to .env.local for `next dev`, and also add these as BUILD variables
# in the Cloudflare dashboard (Workers & Pages > prolearnin6 > Settings >
# Build > Variables) so `next build` can inline them into the client bundle.
# These are public by design (NEXT_PUBLIC_*) - never put secrets here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
